module ex-edit {
  yang-version 1.1;
  namespace "urn:example:edit";
  prefix ee;
  import ex-json { prefix ej; }
  revision 2026-11-09;

  container sys {
    leaf host { type string; }
    leaf mtu { type uint16 { range "68..9000"; } }
    leaf kind { type identityref { base ej:base-type; } }
    list user {
      key name;
      ordered-by user;
      leaf name { type string; }
      leaf uid { type uint32; }
    }
    leaf-list dns { type string; ordered-by user; }
    container state {
      config false;
      leaf up { type boolean; }
    }
  }
}
